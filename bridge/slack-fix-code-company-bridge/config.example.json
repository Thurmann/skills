{
  "teamId": "T_REPLACE",
  "allowedUsers": [
    "U_REPLACE"
  ],
  "allowedChannels": [
    "C_REPLACE"
  ],
  "runtimePriority": [
    "claude",
    "codex",
    "gemini",
    "opencode"
  ],
  "stateDir": "./state",
  "pythonPath": "python3",
  "ghPath": "gh",
  "githubAuth": "app",
  "githubTokenFile": "/run/fix-code-bridge/gh-token",
  "allowNetwork": true,
  "repositoryRouting": {
    "mode": "channel",
    "cloneRoot": "./state/repositories",
    "allowedOwners": [
      "your-org"
    ],
    "channelOwners": {}
  },
  "timeoutMs": 1800000,
  "maxRepairRounds": 2,
  "runtimes": {
    "claude": {
      "path": "claude",
      "models": {
        "precheck": "haiku",
        "architect": "opus",
        "implementer": "haiku",
        "reviewer": "opus"
      },
      "allowedModels": [
        "opus",
        "sonnet",
        "haiku"
      ],
      "env": [
        "CLAUDE_CODE_USE_VERTEX",
        "ANTHROPIC_VERTEX_PROJECT_ID",
        "CLOUD_ML_REGION",
        "CLAUDE_CODE_USE_FOUNDRY",
        "ANTHROPIC_FOUNDRY_RESOURCE",
        "AZURE_CLIENT_ID",
        "ANTHROPIC_DEFAULT_OPUS_MODEL",
        "ANTHROPIC_DEFAULT_SONNET_MODEL",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL"
      ]
    },
    "codex": {
      "path": "codex",
      "models": {
        "precheck": "gpt-6-luna",
        "architect": "gpt-6.1-sol",
        "implementer": "gpt-6-luna",
        "reviewer": "gpt-6.1-sol"
      },
      "allowedModels": [
        "gpt-6.1-sol",
        "gpt-6-luna"
      ]
    },
    "gemini": {
      "path": "gemini",
      "models": {
        "precheck": "gemini-2.5-flash",
        "architect": "gemini-2.5-pro",
        "implementer": "gemini-2.5-flash",
        "reviewer": "gemini-2.5-pro"
      },
      "allowedModels": [
        "gemini-2.5-pro",
        "gemini-2.5-flash"
      ]
    },
    "opencode": {
      "path": "opencode",
      "models": {
        "precheck": "anthropic/claude-haiku-4-5",
        "architect": "anthropic/claude-opus-4-5",
        "implementer": "anthropic/claude-haiku-4-5",
        "reviewer": "anthropic/claude-opus-4-5"
      },
      "allowedModels": [
        "anthropic/claude-opus-4-5",
        "anthropic/claude-haiku-4-5"
      ],
      "env": [
        "ANTHROPIC_API_KEY"
      ]
    }
  }
}
