# Optional settings for scripts/azure-up.sh. Copy to scripts/azure.env (gitignored) and edit.
# Plain KEY=value lines; the file is parsed, never sourced. Environment variables with the
# same name override values in this file. Every key is optional.
#
# Slack IDs (teamId, allowedUsers, allowedChannels, ...) come from the local bridge's
# ~/.config/fix-code-bridge/config.json and the tokens from its .env (see --bridge-config and
# --slack-env). Secrets are rejected here: export GITHUB_PAT (otherwise the script asks for it)
# and optionally ANTHROPIC_API_KEY.

# Subscription name or id; must be the selected one (az account set). Empty: the current one.
AZ_SUBSCRIPTION=
# New Pay-As-You-Go subscriptions are not offered every VM size in every region; the script
# checks before it creates anything.
LOCATION=swedencentral
RESOURCE_GROUP=rg-fix-code-cloud
VM_NAME=vm-fix-code-cloud
VM_SIZE=Standard_B2s
# Globally unique, 3-24 characters. Empty: kv-fixcode-<hash of subscription and group>.
KEY_VAULT=
# Must be cloneable without credentials (cloud-init clones it to /opt/fix-code).
REPO_URL=https://github.com/Thurmann/skills.git

# GitHub owners the bridge may clone from (comma-separated). Empty: allowedOwners from the
# local config, else your gh login.
GITHUB_OWNERS=
# Commit identity on the VM. Empty: your GitHub name and <id>+<login>@users.noreply.github.com.
GIT_USER_NAME=
GIT_USER_EMAIL=

# Claude via Microsoft Foundry and the VM's managed identity (instead of ANTHROPIC_API_KEY):
# the full ARM id of the Foundry (Cognitive Services) account, and the deployment names.
FOUNDRY_RESOURCE_ID=
ANTHROPIC_DEFAULT_OPUS_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=

# Install the Claude CLI on the VM (npm install -g @anthropic-ai/claude-code).
INSTALL_CLAUDE_CLI=true
