{
  "display_information": {
    "name": "Fix Code",
    "description": "Run scoped coding tasks with the local fix-code skill",
    "background_color": "#16324f"
  },
  "features": {
    "bot_user": { "display_name": "Fix Code", "always_online": false }
  },
  "oauth_config": {
    "scopes": { "bot": ["app_mentions:read", "chat:write", "channels:read", "groups:read"] }
  },
  "settings": {
    "event_subscriptions": { "bot_events": ["app_mention"] },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
