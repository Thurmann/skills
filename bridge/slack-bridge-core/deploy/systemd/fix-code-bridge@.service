# Template unit. The instance name is the bridge variant directory, e.g.
#   systemctl enable --now fix-code-bridge@slack-fix-code-personal-cloud-bridge
[Unit]
Description=fix-code Slack bridge (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fixcode
Group=fixcode
WorkingDirectory=/opt/fix-code/bridge/%i
# HOME is writable by fixcode and the coding agents. fetch-secrets.sh (root) does NOT trust it:
# it runs the cloud CLIs with its own root-only HOME and a scrubbed environment.
Environment=HOME=/var/lib/%i
# Non-secret settings (e.g. CLAUDE_CODE_USE_FOUNDRY=1) and fetched secrets (Slack tokens, API keys).
EnvironmentFile=-/etc/%i/bridge.env
# secrets.env lives in a ROOT-owned directory (not a RuntimeDirectory of this unit): systemd applies
# EnvironmentFile to the root ExecStartPre too, so fixcode must never be able to rewrite it.
EnvironmentFile=-/run/fix-code-secrets/%i/secrets.env
# Runs as root ("+") so it can fetch secrets with the machine identity and hand them to fixcode.
# "env -i" gives it an empty environment, so nothing from HOME or the EnvironmentFiles above
# (BASH_ENV, LD_PRELOAD, PATH, ...) reaches the root process.
ExecStartPre=+/usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin /bin/bash /opt/fix-code/bridge/slack-bridge-core/deploy/bin/fetch-secrets.sh %i
ExecStart=/usr/bin/node src/cli.js start --config /etc/%i/config.json
Restart=on-failure
RestartSec=10
StateDirectory=%i
StateDirectoryMode=0700

# Hardening that keeps git, gh and the coding CLIs working.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
